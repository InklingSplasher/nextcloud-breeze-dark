{
    "name": "breezedark",
    "version": "35.2.0",
    "description": "InkCurity Dark theme for Nextcloud",
    "author": "Magnus Walbeck, inkcurity.net",
    "devDependencies": {
        "postcss-scss": "^4.0.9",
        "prettier": "^3.9.5",
        "sass": "^1.101.0",
        "stylelint": "^17.14.0",
        "stylelint-prettier": "^5.0.3"
    },
    "scripts": {
        "watch": "sass --silence-deprecation=import --poll --watch css/server.scss:css/server.css css/server-automatic.scss:css/server-automatic.css css/guest.scss:css/guest.css css/guest-automatic.scss:css/guest-automatic.css",
        "build": "sass --silence-deprecation=import --no-source-map css/server.scss:css/server.css css/server-automatic.scss:css/server-automatic.css css/guest.scss:css/guest.css css/guest-automatic.scss:css/guest-automatic.css",
        "prettier": "prettier --check css js",
        "prettier:fix": "prettier --write css js",
        "stylelint": "stylelint css",
        "stylelint:fix": "stylelint css --fix"
    }
}
